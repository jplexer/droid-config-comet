[Unit]
Description=Allow developer mode USB networking (NCM usb0) through the firewall
# connman only opens SSH for wifi/ethernet and ignores usb* interfaces, so
# usb0 never gets a connman service and its INPUT DROP policy applies.
# usb0 only exists in developer mode (usb-moded creates ncm.usb0 then).
After=connman.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/sbin/iptables -I INPUT 1 -i usb0 -j ACCEPT
ExecStart=/sbin/ip6tables -I INPUT 1 -i usb0 -j ACCEPT
ExecStop=/sbin/iptables -D INPUT -i usb0 -j ACCEPT
ExecStop=/sbin/ip6tables -D INPUT -i usb0 -j ACCEPT

[Install]
WantedBy=multi-user.target
